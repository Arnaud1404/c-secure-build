#!/usr/bin/env bash
set -u

echo "pre-commit: build, memory gate, security gate"

if ! make > /dev/null 2>&1; then
    echo "BLOCKED: the code does not build." >&2
    exit 1
fi

if ! make test-mem > /dev/null 2>&1; then
    echo "BLOCKED: Valgrind found a memory error. Run 'make test-mem'." >&2
    exit 1
fi

./scripts/scan.sh
scan_status=$?

case "$scan_status" in
    0) ;;
    1)
        echo "BLOCKED: the security gate found something. See .security/*.sarif." >&2
        exit 1
        ;;
    *)
        echo "ERROR: the security gate could not run. Your toolchain is incomplete," >&2
        echo "so nothing was scanned. This is not a finding. See the message above." >&2
        exit 1
        ;;
esac

echo "pre-commit: all gates passed"
